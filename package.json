{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && rm -f ./public/hot",
        "build:analyze": "ANALYZE=true npm run build",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "types": "tsc --noEmit",
        "types:generate": "effect-schema transform --config effect-schema.toml"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@michael4d45/effect-schema-generator": "^0.7.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^5.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-no-manual-memo": "^1.0.4",
        "globals": "^17.11.0",
        "laravel-vite-plugin": "^2.0.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.0.7",
        "vite-plugin-pwa": "^1.3.0",
        "workbox-core": "^7.4.1",
        "workbox-expiration": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "dexie": "^4.4.5",
        "effect": "^3.22.1",
        "idb": "^8.0.3",
        "laravel-echo": "^2.4.0",
        "lucide-react": "^1.33.0",
        "pusher-js": "^8.6.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.3",
        "react-hot-toast": "^2.6.0",
        "react-router": "^8.3.0",
        "rollup-plugin-visualizer": "^7.1.1",
        "tailwind-merge": "^3.6.0",
        "workbox-window": "^7.4.1"
    }
}
