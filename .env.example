# Local stack is Lerd (.lerd.yaml). After clone:
#   lerd setup --all
# That writes service hosts, APP_URL, Reverb, and Vite keys.
# Re-run `lerd env` after changing .lerd.yaml env_overrides.

APP_NAME="React SPA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# lerd env_overrides replace these from .lerd.yaml ({{scheme}}://{{domain}}).
APP_SCHEME=https
HOST_NAME=react-spa.test
APP_PORT=80

APP_URL=${APP_SCHEME}://${HOST_NAME}

VITE_DEV_HOST=0.0.0.0
VITE_DEV_SERVER_URL=http://${HOST_NAME}:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PHP-FPM and `php artisan` use Lerd's php shim (podman exec into FPM),
# so they resolve these on the lerd network. GUI clients on the host
# (TablePlus, psql, redis-cli) use 127.0.0.1 with the same port/user/password.
DB_CONNECTION=pgsql
DB_HOST=lerd-postgres
DB_PORT=5432
DB_DATABASE=react-spa
DB_USERNAME=postgres
DB_PASSWORD=lerd

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=lerd-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=lerd-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTEXT_LOG_HTTP_ENABLED=false
CONTEXT_LOG_HTTP_CAPTURE_HEADERS=false
CONTEXT_LOG_HTTP_CAPTURE_BODY=false
CONTEXT_LOG_REQUEST=false
CONTEXT_LOG_RESPONSE=false
CONTEXT_LOG_USER=false
CONTEXT_LOG_DB=false
CONTEXT_LOG_CACHE=false
CONTEXT_LOG_QUEUE=false
CONTEXT_LOG_MAIL=false
CONTEXT_LOG_REVERB=false
CONTEXT_LOG_SCHEDULE=false
CONTEXT_LOG_NOTIFICATIONS=false
CONTEXT_LOG_BROADCASTING=false

SHOULD_LOG_VALIDATION_ERRORS=true

GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# lerd env_overrides set the Reverb server bind and the public Vite hosts.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${HOST_NAME}"
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME="${APP_SCHEME}"
